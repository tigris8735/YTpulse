generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  plan          String   @default("free")
  proExpiresAt  DateTime? @map("pro_expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  generationJobs GenerationJob[]
  payments       Payment[]

  @@map("users")
}

model TrendsCache {
  id         String   @id @default(cuid())
  filter     String
  region     String   @default("US")
  youtubeJson Json    @map("youtube_json")
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@unique([filter, region])
  @@map("trends_cache")
}

model PreviewTags {
  videoId       String  @id @map("video_id")
  faceCloseup   Boolean @default(false) @map("face_closeup")
  highContrast  Boolean @default(false) @map("high_contrast")
  textArea      Boolean @default(false) @map("text_area")
  centerObject  Boolean @default(false) @map("center_object")
  scoreSum      Int     @default(0) @map("score_sum")
  analyzedAt    DateTime @default(now()) @map("analyzed_at")

  @@map("preview_tags")
}

model GenerationJob {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  status    String   @default("queued")
  fileUrl   String?  @map("file_url")
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("generation_jobs")
}

model Payment {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  yookassaId  String   @map("yookassa_id")
  term        String
  amount      Int
  status      String   @default("pending")
  rawWebhook  Json?    @map("raw_webhook")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("payments")
}
