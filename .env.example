# ============================================================
# YT Pulse — Environment Variables
# ============================================================
# Скопируйте этот файл в .env и заполните своими значениями

# --- DATABASE (Neon PostgreSQL) ---
# Получите URL в консоли: https://neon.tech
# Формат: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# --- AUTH ---
# Сгенерируйте случайную строку: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# --- YOUTUBE DATA API v3 ---
# Google Cloud Console → APIs → YouTube Data API v3 → Credentials
YOUTUBE_API_KEY="your-youtube-data-api-key"

# --- AI: GROQ (Primary text generation) ---
# https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key"

# --- AI: GEMINI (Fallback text + image generation) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# --- PAYMENTS: YOOKASSA TEST ---
# https://yookassa.ru/developers/ → Тестовый кабинет
YOOKASSA_SHOP_ID="your-test-shop-id"
YOOKASSA_SECRET_KEY="your-test-secret-key"
YOOKASSA_RETURN_URL="http://localhost:3000/payments/success"

# --- OPTIONAL: PYTHON ANALYZER ---
# Если запускаете Python-сервис из папки analyzer/
ANALYZER_URL=""
